# Copy this file to .env and fill in real values. Never commit .env.
# Every variable below is read by apps/server/src/config.ts unless noted.

# --- Server ---
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- Storage ---
APP_DATA_DIR=.data
AGENT_WORKSPACE_ROOT=workspaces
CODEX_HOME=codex-home

# --- Codex CLI / Runtime ---
CODEX_BIN=codex
# read-only | workspace-write | danger-full-access
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# local-process | container
RUNTIME_PROVIDER=container
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
# Defaults to the current host UID:GID if unset.
# CONTAINER_USER=1000:1000
RUNTIME_INSTANCE_ID=default

# --- Access control ---
# Shared demo bearer token — NOT user identity or authorization.
# Required (24+ chars) for a non-loopback production HOST.
# APP_AUTH_TOKEN=replace-with-a-long-random-token

# --- ModelArk (BytePlus / Volcengine) ---
# Never reaches the browser; only the trusted server and Runtime see it.
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- Orchestration middleware (not yet read by config.ts) ---
# The control plane (apps/server/src/orchestration/control) and execution
# engine (apps/server/src/orchestration/engine) are fully built and tested,
# but Final Assembly has not yet wired their construction into
# apps/server/src/index.ts. Until that happens, these variables are
# documentation of the intended shape, not variables config.ts parses.
# See docs/handoffs/task-1-control-plane.md (section 9.3 of the original
# spec) and docs/handoffs/task-2-engine.md for what Final Assembly needs to
# construct: per-role model IDs (falling back to ARK_MODEL when unset), a
# PricingTable for estimated-dollar accounting (omit for token-only
# reporting), default BudgetPolicy values, an orchestration scratch root
# under APP_DATA_DIR for isolated worker/staging workspaces, and a trusted
# allowlist of protected/global verification commands.
