HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
APP_DATA_DIR=.data
AGENT_WORKSPACE_ROOT=workspaces
CODEX_HOME=codex-home
CODEX_BIN=codex
CODEX_MODEL_REASONING_EFFORT=low
CODEX_MODEL_REASONING_SUMMARY=none
CODEX_SANDBOX_MODE=workspace-write
# Per-Codex-turn timeout in milliseconds (one CLI invocation, not the whole
# orchestration). Increase if a single Direct message or worker/planner turn
# needs more time. Default: 1800000 (30 minutes).
# CODEX_TIMEOUT_MS=1800000
RUNTIME_PROVIDER=local-process

# Required for model-backed runs. Never commit the real key.
ARK_API_KEY=replace-with-modelark-key
ARK_MODEL=replace-with-endpoint-or-model-id
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Recommended orchestration setup. All concurrent workers share the same small
# endpoint; planner, integrator, and verifier share the big endpoint.
ORCHESTRATION_BIG_MODEL=replace-with-dola-seed-2.1-turbo-endpoint-id
ORCHESTRATION_SMALL_MODEL=replace-with-deepseek-v4-flash-endpoint-id

# Optional advanced per-role overrides. Leave these empty to use the big/small
# mapping above. All values ultimately fall back to ARK_MODEL.
ORCHESTRATION_PLANNER_MODEL=
ORCHESTRATION_WORKER_MODEL=
ORCHESTRATION_VERIFIER_MODEL=
ORCHESTRATION_INTEGRATOR_MODEL=

# Optional trusted paths; defaults stay below APP_DATA_DIR.
ORCHESTRATION_RUNTIME_HOME_ROOT=
ORCHESTRATION_TEMP_ROOT=
ORCHESTRATION_ARCHIVE_ROOT=
ORCHESTRATION_PROTECTED_EVALUATOR_ROOT=

# Optional common Ark pricing (USD per one million tokens). Leave all absent for unknown pricing.
# ARK_INPUT_USD_PER_MILLION=0
# ARK_CACHED_INPUT_USD_PER_MILLION=0
# ARK_OUTPUT_USD_PER_MILLION=0

# Token budgets are disabled by default. Set either variable only when a
# cumulative per-run token ceiling is desired.
# ORCHESTRATION_MAX_INPUT_TOKENS=1000000
# ORCHESTRATION_MAX_OUTPUT_TOKENS=250000

# Optional bounded-execution defaults.
# ORCHESTRATION_MAX_MODEL_CALLS=100
# ORCHESTRATION_MAX_WORKER_ATTEMPTS=3
# ORCHESTRATION_MAX_CONTEXT_EXPANSIONS=3
# ORCHESTRATION_MAX_WALL_CLOCK_MS=1800000

# Development/test only; production validation rejects true.
ORCHESTRATION_DEMO_FIXTURE=false

# Set a long random value before exposing a production host.
APP_AUTH_TOKEN=
