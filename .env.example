# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000

# =====================================================================
# Orchestration middleware
# =====================================================================
# Every value below is optional. With none of them set, one configured Ark
# endpoint serves all four logical roles, estimated dollars stay unknown, and
# the default hard budget applies. Nothing here is ever accepted from the
# browser: model IDs, prices, and paths are trusted server configuration only.

# Logical role to model ID. Leave a role unset to fall back to ARK_MODEL.
# When the installed Codex CLI cannot override the model, every role truthfully
# reports the fallback model in its evidence instead of claiming a cheaper one.
# ORCHESTRATION_PLANNER_MODEL=ep-your-strong-endpoint-id
# ORCHESTRATION_WORKER_MODEL=ep-your-cheaper-endpoint-id
# ORCHESTRATION_VERIFIER_MODEL=ep-your-endpoint-id
# ORCHESTRATION_INTEGRATOR_MODEL=ep-your-endpoint-id

# USD per million tokens, keyed by model ID. Any model missing from this map
# keeps estimated dollars null and reports pricingStatus "unknown"; the UI then
# shows "Pricing not configured" and never invents a dollar value.
# ORCHESTRATION_MODEL_PRICING={"ep-your-endpoint-id":{"input":0.3,"cachedInput":0.05,"output":1.2}}

# Trusted roots. Defaults live under APP_DATA_DIR. PROTECTED_EVALUATOR_ROOT
# holds protected acceptance checks at mode 0700; it is never mounted into a
# worker Runtime, copied into a worker snapshot, or returned by the API.
# ORCHESTRATION_TEMP_ROOT=/app/data/orchestration/temp
# ORCHESTRATION_ARCHIVE_ROOT=/app/data/orchestration/archive
# ORCHESTRATION_RUNTIME_HOME_ROOT=/app/data/orchestration/runtime-homes
# PROTECTED_EVALUATOR_ROOT=/app/data/protected-evaluators

# What happens to a worker's temporary workspace after a task ends.
# archive keeps it for inspection; retain is for debugging only.
ORCHESTRATION_CLEANUP_POLICY=archive

# Hard budget. These stop new work; they are enforced in the control plane, not
# suggested to the model. Leaving a token or dollar limit unset means "no hard
# limit for that dimension"; the call, step, attempt, expansion, and wall-clock
# limits always apply.
# ORCHESTRATION_MAX_INPUT_TOKENS=400000
# ORCHESTRATION_MAX_OUTPUT_TOKENS=120000
# ORCHESTRATION_MAX_ESTIMATED_USD=5
ORCHESTRATION_MAX_MODEL_CALLS=40
ORCHESTRATION_MAX_STEPS=80
ORCHESTRATION_MAX_WORKER_ATTEMPTS=3
ORCHESTRATION_MAX_CONTEXT_EXPANSIONS=2
ORCHESTRATION_MAX_WALL_CLOCK_MS=900000

# The direct-versus-orchestrated benchmark writes its two isolated workspace
# copies under ORCHESTRATION_TEMP_ROOT and removes them when the run ends.
# There is no separate benchmark path setting. See docs/DEMO.md.
